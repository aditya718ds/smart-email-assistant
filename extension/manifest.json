{
  "manifest_version": 3,
  "name": "Smartmail — Email Reply Assistant",
  "version": "1.1.1",
  "description": "Preview and draft email replies through your local Smart Email Assistant.",
  "host_permissions": ["http://127.0.0.1:8080/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_popup": "popup.html", "default_title": "Smartmail Reply Assistant"}
}
